APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Escalate ────────────────────────────────────────────────────────────────
# Server-side only. Nothing below is ever rendered into a page, and the app
# refuses to generate rather than falling back to a baked-in default — so a
# missing key fails loudly at generation time, not silently.
#
# Without ANTHROPIC_API_KEY no reading can be written. Without
# ELEVENLABS_API_KEY no narration can be recorded (the words still work).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT=120

ELEVENLABS_API_KEY=
# Multilingual v2, NOT Flash. Flash is built for real-time conversational
# agents, where latency beats everything; narration here is a queued job that
# nobody is waiting on an open socket for, so buying speed with quality buys
# nothing. This file used to say eleven_flash_v2_5, which meant every fresh
# deploy — `composer setup` copies this file — silently reverted narration to
# the cheap-sounding model the config had already moved away from.
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_FORMAT=mp3_44100_128
ELEVENLABS_SPEED=0.92
ELEVENLABS_TIMEOUT=180

# ── Beta gates ──────────────────────────────────────────────────────────────
# Both default to true in config even if absent here. Leave them on for a
# closed beta; turning either off widens who can spend your provider credit.
#
# INVITE_ONLY        registration needs an unclaimed code from `escalate:invite`
# REQUIRE_VERIFICATION  the four paid routes need a confirmed email address
#
# REQUIRE_VERIFICATION needs working mail. So does password reset, so this adds
# no new infrastructure — but if MAIL_MAILER is still `log`, beta users will
# never receive the link and generation will stay shut. Configure SMTP, or set
# this to false deliberately while you sort it out.
INVITE_ONLY=true
REQUIRE_VERIFICATION=true
INVITE_DAYS=30

# ── The ceiling: a whole-app daily cap, on top of the per-user quotas below ──
# The per-user quota multiplies by the number of accounts; this does not. Size
# it at roughly (expected users) x (per-user quota), with headroom. 0 disables
# a given ceiling entirely — which means unlimited, so be sure you mean it.
CEILING_STORIES_PER_DAY=200
CEILING_NARRATIONS_PER_DAY=300
CEILING_REWINDS_PER_DAY=100

# ── Stripe ──────────────────────────────────────────────────────────────────
# BILLING_ENABLED=false means quotas ignore plans entirely and everyone gets the
# flat numbers below — which is exactly how the app behaved before Stripe
# existed. Turning it on is what makes an allowance depend on a subscription, so
# do not enable it until the keys and price ids below are real.
BILLING_ENABLED=false

STRIPE_KEY=
STRIPE_SECRET=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Cashier REJECTS every webhook when this is unset rather than
# trusting the body, so an unset value fails closed — subscriptions will simply
# never appear in the app.
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

# Price ids come from Stripe (price_…), never a number typed here: the amount
# the customer is actually charged lives in Stripe, and a second copy in this
# file is a second source of truth for the same fact. The _LABEL values are only
# what the page prints — if one disagrees with Stripe, the label is the bug.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_MONTHLY_LABEL="$12 / month"
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_YEARLY_LABEL="$120 / year"

# Days of full access before the first charge. 0 for none.
BILLING_TRIAL_DAYS=0

# Per-user daily spend limits. Generation is the only expensive thing here.
QUOTA_STORIES_PER_DAY=5
QUOTA_NARRATIONS_PER_DAY=8
QUOTA_REGENERATIONS=4
QUOTA_AFFIRMATION_SETS_PER_DAY=2
QUOTA_REWINDS_PER_DAY=3

# Must exceed the longest job timeout (NarrateStory, 240s) or the database
# queue hands a still-running job to a second worker and you pay twice.
DB_QUEUE_RETRY_AFTER=300

# Comma-separated proxy IPs/CIDRs, ONLY if a CDN sits in front. Leave empty for
# a directly-served origin. Never set this to '*': trusting every proxy means
# the client controls its own IP address via X-Forwarded-For, and every rate
# limit in this app — including the login lockout — stops working.
TRUSTED_PROXIES=

# Set to true in production. Without it the session cookie ships without the
# Secure flag and a single plain-HTTP request leaks it in clear.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

{
  "name": "Escalate",
  "short_name": "Escalate",
  "description": "Turns what you want into short, personal stories you can read or listen to. Keeps your affirmations, your gratitude and a record of what came true.",
  "id": "/?source=pwa",
  "start_url": "/today?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#241D2B",
  "background_color": "#241D2B",
  "categories": ["lifestyle", "health", "productivity"],
  "dir": "ltr",
  "lang": "en",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Your cards for today, and what you are working on",
      "url": "/today?source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Write a gratitude",
      "short_name": "Gratitude",
      "description": "Record something you are grateful for",
      "url": "/gratitude/create?source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Name a desire",
      "short_name": "New desire",
      "description": "Name something you want",
      "url": "/desires/create?source=shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}

# ErikaKPage — clean URLs + upload limits (Apache / cPanel)

# Make index.php the default document, and stop Apache guessing file names.
DirectoryIndex index.php
# If this next line causes a 500 error on your host, delete just this line.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories directly (uploads, assets, admin.php, submit.php, setup.php, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> front controller (index.php reads the path via routes.php)
  RewriteRule ^ index.php [L]
</IfModule>

# Photo library uses WEBP for the cut-outs (transparency at a fraction of PNG weight).
# Older Apache builds have no mapping for it and would send the wrong content type.
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# The whole site is one document (every page inlined, shown one at a time), so the
# HTML is large — around 220 KB raw and under 45 KB compressed. Compressing it is
# the single biggest saving on a phone connection.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
                                application/javascript application/json \
                                image/svg+xml application/xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json
</IfModule>

# Long-lived caching for the shipped photos — their filenames never change in place.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
</IfModule>

# Upload-size fallback if .user.ini isn't picked up (works under mod_php).
<IfModule mod_php.c>
  php_value upload_max_filesize 300M
  php_value post_max_size 320M
  php_value memory_limit 512M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>

# Never expose config or the SQLite fallback file.
<FilesMatch "^(config\.php|config\.local\.php|cms\.sqlite)$">
  Require all denied
</FilesMatch>

config.local.php
cms.sqlite
uploads/*
!uploads/.htaccess
!uploads/private/
uploads/private/*
!uploads/private/.htaccess
.gstack/
tools/guides/.fontcache/

# Downloadable copies made for the owner (e.g. the Canva page export); not site code
exports/

# Site zips are built on request into the scratchpad, never committed (GitHub refuses >100 MB)
dist/

# Python bytecode
__pycache__/

# ---- The other projects in this repo (merged from claude/escalate-app-bugs-l73sgw, 19 Oct 2026) ----
# Build artifact — rebuilt from manifest-n8n/ with:
#   cd manifest-n8n && zip -r ../manifest-n8n.zip index.html manifest-workflow.json README.md
manifest-n8n.zip

# Local API keys for the PHP demo (see stella-demo/api/config.php)
stella-demo/api/config.local.php

# SQLite dev database — never a deliverable
/escalate/database/database.sqlite
/escalate/database/*.sqlite-journal

# Installed skill bundles (cloned from upstream, see docs/SKILLS.md)
/.claude/skills/

# UI tour screenshots — regenerate, do not version (4.6MB of PNGs)
/docs/screens/

# Picture copies the server makes from admin uploads (WebP ladder, link-preview JPEGs); like
# uploads/ itself, they live on the host only
assets/rimg/*/uploads/
assets/rimg/og/
